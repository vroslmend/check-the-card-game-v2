# Copy to .env and adjust. Defaults shown are what the code falls back to.

# Port the server listens on. Render sets this automatically in production.
PORT=8000

# Comma-separated browser origins allowed to connect. Required in production;
# startup fails closed when it is missing or empty. This is origin admission,
# not authentication: custom clients can forge Origin and still need the
# resource limits below.
CORS_ORIGIN=http://localhost:3000,https://check-the-game.vercel.app

# --- Resource protection ---

# Hard ceiling for in-memory game machines held by one server process.
MAX_ACTIVE_GAMES=200

# Largest Socket.IO message accepted before Engine.IO closes the connection.
MAX_HTTP_BUFFER_SIZE_BYTES=16384

# Game creation is limited per client IP so reconnecting cannot reset it.
CREATE_GAME_RATE_LIMIT=3
CREATE_GAME_RATE_LIMIT_WINDOW_MS=60000

# Combined CREATE_GAME, JOIN_GAME and ATTEMPT_REJOIN budget per client IP.
HANDSHAKE_RATE_LIMIT=30
HANDSHAKE_RATE_LIMIT_WINDOW_MS=60000

# Render is detected automatically. Set this only when another trusted reverse
# proxy overwrites/appends X-Forwarded-For with the real client address.
TRUST_PROXY=false

# Gameplay and chat budgets per player seat (or client IP before joining).
# Chat also counts as a player action when it arrives through PLAYER_ACTION.
PLAYER_ACTION_RATE_LIMIT=60
PLAYER_ACTION_RATE_LIMIT_WINDOW_MS=10000
CHAT_MESSAGE_RATE_LIMIT=10
CHAT_MESSAGE_RATE_LIMIT_WINDOW_MS=10000

# --- Game configuration ---

# Seats a game holds when the host does not choose one. Hosts pick 2 to 6 in the lobby.
MAX_PLAYERS=4

# Cards dealt to each player at the start of a round.
CARDS_PER_PLAYER=4

# Hand size that disqualifies a player for the rest of the round.
MAX_HAND_SIZE=8

# --- Timers, all in milliseconds ---

# How long the initial peek at your bottom two cards lasts.
PEEK_DURATION_MS=10000

# How long the window to match a discarded card stays open.
MATCHING_STAGE_DURATION_MS=5000

# How long a player has to act before their turn auto resolves.
TURN_TIMER_MS=45000

# How long a disconnected player keeps their seat mid game before forfeiting.
RECONNECT_TIMEOUT_MS=120000

# The same, for a player who drops while still in the lobby.
LOBBY_DISCONNECT_TIMEOUT_MS=120000
