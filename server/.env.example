# Copy to .env and adjust. Defaults shown are what the code falls back to.

# Port the server listens on. Render sets this automatically in production.
PORT=8000

# Comma separated list of origins allowed to connect.
CORS_ORIGIN=http://localhost:3000,https://check-the-game.vercel.app

# --- Game configuration ---

# Seats a game holds when the host does not choose one. Hosts pick 2 to 6 in the lobby.
MAX_PLAYERS=4

# Cards dealt to each player at the start of a round.
CARDS_PER_PLAYER=4

# Hand size that disqualifies a player for the rest of the round.
MAX_HAND_SIZE=8

# --- Timers, all in milliseconds ---

# How long the initial peek at your bottom two cards lasts.
PEEK_DURATION_MS=10000

# How long the window to match a discarded card stays open.
MATCHING_STAGE_DURATION_MS=5000

# How long a player has to act before their turn auto resolves.
TURN_TIMER_MS=45000

# How long a disconnected player keeps their seat mid game before forfeiting.
RECONNECT_TIMEOUT_MS=120000

# The same, for a player who drops while still in the lobby.
LOBBY_DISCONNECT_TIMEOUT_MS=120000
